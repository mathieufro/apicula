export GOWINHOME=/Applications/GowinIDE.app/Contents/Resources/Gowin_EDA
export DYLD_LIBRARY_PATH=/Applications/GowinIDE.app/Contents/Resources/Gowin_EDA/IDE/lib
export DYLD_FRAMEWORK_PATH=/Applications/GowinIDE.app/Contents/Resources/Gowin_EDA/IDE/lib
# The open flow's own tools. `examples/gw5a/Makefile` and the heavy
# example-build test invoke `nextpnr-himbaechel` and `gowin_pack` by name, so
# the gate must not depend on the caller's interactive PATH for them: the
# installed nextpnr is the one paired with the installed chipdb, and the
# `gowin_pack` entry point comes from the editable apycula install in the venv.
# Spelled in full rather than prepended to the caller's PATH: this file is
# `include`d by `gate.mk`, where `$PATH` would be read as the make variable
# `$(P)` followed by `ATH`, and a gate that inherits an interactive PATH is
# not reproducible anyway.
export PATH=/Users/alex/fine-line-data/open-toolchain-gw5ast/toolchains/nextpnr/bin:/Users/alex/fine-line/vendor/venv/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
