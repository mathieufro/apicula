#!/bin/sh
# Local blocking gate -- pre-commit (C8, D75-D77).
#
# Runs `make gate GATE_SCOPE=fast` in the foreground and refuses the commit
# on any failing check. Never bypassed with the bypass flag (LOOP-BRIEF).
set -e

root="$(git rev-parse --show-toplevel)"

# Export the gate's own environment (GOWINHOME, DYLD_*) so this hook works
# from a bare shell that never sourced LOOP-BRIEF's env block (F87).
if [ -f "$root/gate.env" ]; then
    . "$root/gate.env"
fi

exec make -C "$root" gate GATE_SCOPE=fast
